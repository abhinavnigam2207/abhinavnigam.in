{
  "name": "abhinavsite",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server/_core/index.ts",
    "build": "tsx scripts/build-knowledge.ts && vite build && tsx scripts/prerender.ts && tsx scripts/check-seo.ts && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "dev:static": "vite --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "build:static": "vite build",
    "check:seo": "tsx scripts/check-seo.ts",
    "knowledge": "tsx scripts/build-knowledge.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.13",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "serverless-http": "^4.0.0",
    "superjson": "^1.13.3",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "d3-geo": "3.1.1",
    "esbuild": "^0.25.0",
    "pnpm": "10.18.0",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "topojson-client": "3.1.0",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4",
    "world-atlas": "2.0.2"
  },
  "packageManager": "pnpm@11.8.0"
}
